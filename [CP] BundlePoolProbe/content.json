{
  "Format": "2.0.0",
  "ConfigSchema": {
    "Coordinates_X": { "Default": 55 },
    "Coordinates_Y": { "Default": 10 }
  },
  "Changes": [
    {
      "Action": "EditMap",
      "Target": "Maps/{{Awassakura.BundlePoolProbe/ActualFarmMapName}}",
      "FromFile": "assets/BPP_FarmWarp.tmx",
      "FromArea": { "X": 0, "Y": 0, "Width": 1, "Height": 2 },
      "ToArea": {
        "X": "{{Query: {{Coordinates_X}} }}",
        "Y": "{{Query: {{Coordinates_Y}} }}",
        "Width": 1,
        "Height": 2
      },
      "PatchMode": "Overlay",
      "Update": "OnLocationChange"
    }
  ]
}
